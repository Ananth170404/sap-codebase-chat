# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is already gitignored — never commit real secrets.
#
# Without this file (or an incomplete one), the app still works fully in
# guest mode — "Sign in with Google" just shows as disabled until this is
# set up.
#
# ── Google OIDC setup ──────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth client ID" of type "Web application".
# 3. Under "Authorized redirect URIs", add the value of redirect_uri below
#    (use your real deployed domain instead of localhost once deployed).
# 4. Copy the generated Client ID / Client secret into client_id /
#    client_secret below.
# 5. Generate cookie_secret with:
#      python -c "import secrets; print(secrets.token_hex(32))"
#
# Streamlit's auth API is fairly new — if these exact keys have changed,
# check the current docs: https://docs.streamlit.io/develop/api-reference/user/st.login

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-secret-see-step-5-above"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
